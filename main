local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Drawings = {}
local Settings = {Aimbot=false,SilentAim=false,ESP=false,TeamCheck=true,FOV=150,Smooth=0.15,AimPart="Head",SilentChance=100,ShowNames=true,ShowBoxes=true,ShowHealth=true,ShowTracers=false}

local Window = Rayfield:CreateWindow({Name="Lite",LoadingTitle="...",LoadingSubtitle="",ConfigurationSaving={Enabled=false}})
local TabAim = Window:CreateTab("Aimbot", 4483362458)
local TabEsp = Window:CreateTab("ESP", 4483362458)

TabAim:CreateToggle({Name="Aimbot",CurrentValue=false,Flag="Aim",Callback=function(v)Settings.Aimbot=v end})
TabAim:CreateToggle({Name="Silent Aim",CurrentValue=false,Flag="Sil",Callback=function(v)Settings.SilentAim=v end})
TabAim:CreateToggle({Name="Team Check",CurrentValue=true,Flag="Team",Callback=function(v)Settings.TeamCheck=v end})
TabAim:CreateSlider({Name="FOV",Range={10,500},Increment=1,Suffix="px",CurrentValue=150,Flag="Fov",Callback=function(v)Settings.FOV=v end})
TabAim:CreateSlider({Name="Smoothness",Range={1,100},Increment=1,Suffix="%",CurrentValue=15,Flag="Sm",Callback=function(v)Settings.Smooth=v/100 end})
TabAim:CreateSlider({Name="Silent Hit %",Range={1,100},Increment=1,Suffix="%",CurrentValue=100,Flag="Hit",Callback=function(v)Settings.SilentChance=v end})
TabAim:CreateDropdown({Name="Target Part",Options={"Head","HumanoidRootPart","UpperTorso"},CurrentOption="Head",Flag="Part",Callback=function(v)Settings.AimPart=v end})

TabEsp:CreateToggle({Name="ESP",CurrentValue=false,Flag="Esp",Callback=function(v)Settings.ESP=v end})
TabEsp:CreateToggle({Name="Team Check",CurrentValue=true,Flag="EspTeam",Callback=function(v)Settings.TeamCheck=v end})
TabEsp:CreateToggle({Name="Names",CurrentValue=true,Flag="Names",Callback=function(v)Settings.ShowNames=v end})
TabEsp:CreateToggle({Name="Boxes",CurrentValue=true,Flag="Boxes",Callback=function(v)Settings.ShowBoxes=v end})
TabEsp:CreateToggle({Name="Health",CurrentValue=true,Flag="Health",Callback=function(v)Settings.ShowHealth=v end})
TabEsp:CreateToggle({Name="Tracers",CurrentValue=false,Flag="Tracers",Callback=function(v)Settings.ShowTracers=v end})

local function IsAlive(p)
    local c=p.Character local h=c and c:FindFirstChildOfClass("Humanoid")
    return c and h and h.Health>0
end
local function IsTeammate(p)
    if not Settings.TeamCheck then return false end
    if p.Team and LocalPlayer.Team then return p.Team==LocalPlayer.Team end
    return false
end
local function GetPart(p,name)
    local c=p.Character return c and c:FindFirstChild(name)
end
local function GetClosest()
    local mouse=UserInputService:GetMouseLocation()
    local best,dist=nil,Settings.FOV
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local part=GetPart(p,Settings.AimPart)
            if part then
                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude
                    if d<dist then dist=d best=p end
                end
            end
        end
    end
    return best
end
local function GetESP(p)
    if Drawings[p] then return Drawings[p] end
    local d={}
    d.Box=Drawing.new("Square") d.Box.Thickness=1 d.Box.Filled=false d.Box.Color=Color3.new(1,0,0) d.Box.Visible=false
    d.BoxOutline=Drawing.new("Square") d.BoxOutline.Thickness=3 d.BoxOutline.Filled=false d.BoxOutline.Color=Color3.new(0,0,0) d.BoxOutline.Visible=false
    d.Name=Drawing.new("Text") d.Name.Size=13 d.Name.Center=true d.Name.Outline=true d.Name.Color=Color3.new(1,1,1) d.Name.Visible=false d.Name.Font=Drawing.Fonts.UI
    d.Health=Drawing.new("Text") d.Health.Size=12 d.Health.Center=true d.Health.Outline=true d.Health.Color=Color3.new(0,1,0) d.Health.Visible=false d.Health.Font=Drawing.Fonts.UI
    d.Tracer=Drawing.new("Line") d.Tracer.Thickness=1 d.Tracer.Color=Color3.new(1,0,0) d.Tracer.Visible=false
    Drawings[p]=d return d
end
local function Clean(p)
    local d=Drawings[p]
    if d then for _,v in pairs(d) do pcall(function()v:Remove()end) end Drawings[p]=nil end
end
Players.PlayerRemoving:Connect(Clean)

local SilentHooked=false
local function HookSilent()
    if SilentHooked then return end
    SilentHooked=true
    local mt=getrawmetatable(game)
    local old=mt.__namecall
    setreadonly(mt,false)
    mt.__namecall=newcclosure(function(self,...)
        local method=getnamecallmethod()
        local args={...}
        if Settings.SilentAim and math.random(1,100)<=Settings.SilentChance then
            if method=="FindPartOnRay" or method=="FindPartOnRayWithIgnoreList" or method=="FindPartOnRayWithWhitelist" or method=="Raycast" then
                local target=GetClosest()
                if target then
                    local part=GetPart(target,Settings.AimPart)
                    if part then
                        if method=="Raycast" and typeof(args[1])=="Vector3" then
                            args[2]=(part.Position-args[1]).Unit*5000
                        elseif method~="Raycast" and typeof(args[1])=="Ray" then
                            args[1]=Ray.new(args[1].Origin,(part.Position-args[1].Origin).Unit*5000)
                        end
                    end
                end
            end
        end
        return old(self,unpack(args))
    end)
    setreadonly(mt,true)
end

RunService.RenderStepped:Connect(function()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            local d=GetESP(p)
            local c=p.Character
            local hum=c and c:FindFirstChildOfClass("Humanoid")
            local head=c and c:FindFirstChild("Head")
            local hrp=c and c:FindFirstChild("HumanoidRootPart")
            if not Settings.ESP or not c or not hum or not head or not hrp or hum.Health<=0 or IsTeammate(p) then
                d.Box.Visible=false d.BoxOutline.Visible=false d.Name.Visible=false d.Health.Visible=false d.Tracer.Visible=false
                continue
            end
            local top,vis1=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.5,0))
            local bot,vis2=Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
            if not vis1 and not vis2 then
                d.Box.Visible=false d.BoxOutline.Visible=false d.Name.Visible=false d.Health.Visible=false d.Tracer.Visible=false
                continue
            end
            local h=math.abs(bot.Y-top.Y)
            local w=h*0.55
            local pos=Vector2.new(top.X-w/2,top.Y)
            d.Box.Size=Vector2.new(w,h) d.Box.Position=pos d.Box.Visible=Settings.ShowBoxes~=false
            d.BoxOutline.Size=Vector2.new(w,h) d.BoxOutline.Position=pos d.BoxOutline.Visible=Settings.ShowBoxes~=false
            d.Name.Text=p.Name d.Name.Position=Vector2.new(top.X,top.Y-18) d.Name.Visible=Settings.ShowNames~=false
            d.Health.Text=math.floor(hum.Health).." HP" d.Health.Position=Vector2.new(top.X,top.Y-32) d.Health.Visible=Settings.ShowHealth~=false
            d.Tracer.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y) d.Tracer.To=Vector2.new(bot.X,bot.Y) d.Tracer.Visible=Settings.ShowTracers==true
        end
    end
    if Settings.Aimbot and UserInputService:IsKeyDown(Enum.KeyCode.Q) then
        local target=GetClosest()
        if target then
            local part=GetPart(target,Settings.AimPart)
            if part then
                local cf=CFrame.new(Camera.CFrame.Position,part.Position)
                Camera.CFrame=Camera.CFrame:Lerp(cf,math.clamp(Settings.Smooth,0.01,0.99))
            end
        end
    end
    if Settings.SilentAim and not SilentHooked then HookSilent() end
end)

