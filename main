--[[
    Repo Executor - Full Cheat Suite
    Aimbot | Silent Aim | Trigger Bot | ESP | Team Check
    Otimizado: sem HttpGet, UI nativa, loops protegidos
]]

--// Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

--// Configs
local Config = {
    Aimbot = {
        Enabled = false,
        Key = Enum.KeyCode.Q,
        Smoothness = 0.12,
        FOV = 150,
        TargetPart = "Head",
        TeamCheck = true,
        WallCheck = false,
        DrawFOV = true
    },
    SilentAim = {
        Enabled = false,
        HitChance = 100,
        TargetPart = "Head",
        TeamCheck = true
    },
    TriggerBot = {
        Enabled = false,
        Delay = 0.05,
        TeamCheck = true
    },
    ESP = {
        Enabled = false,
        TeamCheck = true,
        Box = true,
        Name = true,
        Health = true,
        Tracer = true,
        Distance = false,
        Color = Color3.fromRGB(255, 50, 50)
    }
}

--// Drawing
local Drawings = {}
local FOVcircle = Drawing.new("Circle")
FOVcircle.Visible = false
FOVcircle.Thickness = 1.2
FOVcircle.Filled = false
FOVcircle.NumSides = 64
FOVcircle.Color = Color3.fromRGB(255, 255, 255)
FOVcircle.Transparency = 0.6

--// Utility Functions
local function IsAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function IsTeammate(player, check)
    if not check then return false end
    if player.Team and LocalPlayer.Team then
        return player.Team == LocalPlayer.Team
    end
    return false
end

local function GetPart(player, partName)
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild(partName)
end

local function GetClosestToMouse(maxDist, partName, teamCheck, wallCheck)
    local closest = nil
    local closestDist = maxDist or math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not IsAlive(plr) then continue end
        if IsTeammate(plr, teamCheck) then continue end

        local part = GetPart(plr, partName)
        if not part then continue end

        if wallCheck then
            local origin = Camera.CFrame.Position
            local dir = (part.Position - origin)
            local ray = Ray.new(origin, dir)
            local hit, pos = Workspace:FindPartOnRay(ray, LocalPlayer.Character)
            if hit and not hit:IsDescendantOf(plr.Character) then
                continue
            end
        end

        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = plr
        end
    end
    return closest
end

--// ESP
local function GetESP(player)
    if Drawings[player] then return Drawings[player] end
    local d = {}

    d.Box = Drawing.new("Square")
    d.Box.Thickness = 1
    d.Box.Filled = false
    d.Box.Color = Config.ESP.Color
    d.Box.Visible = false
    d.Box.ZIndex = 2

    d.BoxOutline = Drawing.new("Square")
    d.BoxOutline.Thickness = 3
    d.BoxOutline.Filled = false
    d.BoxOutline.Color = Color3.fromRGB(0,0,0)
    d.BoxOutline.Visible = false
    d.BoxOutline.ZIndex = 1

    d.Name = Drawing.new("Text")
    d.Name.Size = 13
    d.Name.Center = true
    d.Name.Outline = true
    d.Name.Color = Color3.fromRGB(255,255,255)
    d.Name.Visible = false
    d.Name.Font = Drawing.Fonts.UI
    d.Name.ZIndex = 3

    d.Health = Drawing.new("Text")
    d.Health.Size = 12
    d.Health.Center = true
    d.Health.Outline = true
    d.Health.Color = Color3.fromRGB(0,255,100)
    d.Health.Visible = false
    d.Health.Font = Drawing.Fonts.UI
    d.Health.ZIndex = 3

    d.Dist = Drawing.new("Text")
    d.Dist.Size = 11
    d.Dist.Center = true
    d.Dist.Outline = true
    d.Dist.Color = Color3.fromRGB(200,200,200)
    d.Dist.Visible = false
    d.Dist.Font = Drawing.Fonts.UI
    d.Dist.ZIndex = 3

    d.Tracer = Drawing.new("Line")
    d.Tracer.Thickness = 1
    d.Tracer.Color = Config.ESP.Color
    d.Tracer.Visible = false
    d.Tracer.ZIndex = 2

    d.TracerOutline = Drawing.new("Line")
    d.TracerOutline.Thickness = 3
    d.TracerOutline.Color = Color3.fromRGB(0,0,0)
    d.TracerOutline.Visible = false
    d.TracerOutline.ZIndex = 1

    Drawings[player] = d
    return d
end

local function RemoveESP(player)
    local d = Drawings[player]
    if d then
        for _, obj in pairs(d) do
            pcall(function() obj:Remove() end)
        end
        Drawings[player] = nil
    end
end

Players.PlayerRemoving:Connect(RemoveESP)

--// Silent Aim (hook compatível)
local SilentHooked = false
local function SetupSilentAim()
    if SilentHooked then return end
    SilentHooked = true

    local mt = getrawmetatable(game)
    if not mt then return end
    local oldNamecall = mt.__namecall

    if hookmetamethod then
        hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if Config.SilentAim.Enabled and math.random(1,100) <= Config.SilentAim.HitChance then
                if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast" then
                    local target = GetClosestToMouse(Config.Aimbot.FOV, Config.SilentAim.TargetPart, Config.SilentAim.TeamCheck, false)
                    if target then
                        local part = GetPart(target, Config.SilentAim.TargetPart)
                        if part then
                            if method == "Raycast" and typeof(args[1]) == "Vector3" then
                                args[2] = (part.Position - args[1]).Unit * 5000
                            elseif method ~= "Raycast" and typeof(args[1]) == "Ray" then
                                local newDir = (part.Position - args[1].Origin).Unit * 5000
                                args[1] = Ray.new(args[1].Origin, newDir)
                            end
                        end
                    end
                end
            end

            return oldNamecall(self, unpack(args))
        end)
    else
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if Config.SilentAim.Enabled and math.random(1,100) <= Config.SilentAim.HitChance then
                if method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" or method == "Raycast" then
                    local target = GetClosestToMouse(Config.Aimbot.FOV, Config.SilentAim.TargetPart, Config.SilentAim.TeamCheck, false)
                    if target then
                        local part = GetPart(target, Config.SilentAim.TargetPart)
                        if part then
                            if method == "Raycast" and typeof(args[1]) == "Vector3" then
                                args[2] = (part.Position - args[1]).Unit * 5000
                            elseif method ~= "Raycast" and typeof(args[1]) == "Ray" then
                                local newDir = (part.Position - args[1].Origin).Unit * 5000
                                args[1] = Ray.new(args[1].Origin, newDir)
                            end
                        end
                    end
                end
            end

            return oldNamecall(self, unpack(args))
        end)
        setreadonly(mt, true)
    end
end

--// Trigger Bot
local LastTrigger = 0
local function RunTriggerBot()
    if not Config.TriggerBot.Enabled then return end
    local now = tick()
    if now - LastTrigger < Config.TriggerBot.Delay then return end

    local target = Mouse.Target
    if not target then return end

    local model = target:FindFirstAncestorOfClass("Model")
    if not model then return end

    local player = Players:GetPlayerFromCharacter(model)
    if not player or player == LocalPlayer then return end
    if IsTeammate(player, Config.TriggerBot.TeamCheck) then return end
    if not IsAlive(player) then return end

    LastTrigger = now
    if mouse1click then
        mouse1click()
    elseif mouse1press and mouse1release then
        mouse1press()
        task.wait(0.03)
        mouse1release()
    end
end

--// UI (Nativa, leve)
local function CreateUI()
    local SG = Instance.new("ScreenGui")
    SG.Name = "RepoSuite"
    SG.ResetOnSpawn = false
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    pcall(function() SG.Parent = CoreGui end)
    if not SG.Parent then
        SG.Parent = LocalPlayer:WaitForChild("PlayerGui", 3)
    end

    local Main = Instance.new("Frame")
    Main.Size = UDim2.new(0, 240, 0, 340)
    Main.Position = UDim2.new(0, 30, 0.5, -170)
    Main.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true
    Main.Parent = SG
    Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 6)

    local Title = Instance.new("TextLabel", Main)
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    Title.Text = "  Repo Suite v1"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 14
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 6)

    -- Tab buttons
    local TabFrame = Instance.new("Frame", Main)
    TabFrame.Size = UDim2.new(1, 0, 0, 28)
    TabFrame.Position = UDim2.new(0, 0, 0, 30)
    TabFrame.BackgroundTransparency = 1

    local Pages = {}
    local Tabs = {}

    local function NewTab(name, idx)
        local Btn = Instance.new("TextButton", TabFrame)
        Btn.Size = UDim2.new(0.25, 0, 1, 0)
        Btn.Position = UDim2.new((idx-1)*0.25, 0, 0, 0)
        Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        Btn.Text = name
        Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        Btn.TextSize = 12
        Btn.Font = Enum.Font.Gotham
        Btn.BorderSizePixel = 0
        Btn.AutoButtonColor = false

        local Page = Instance.new("ScrollingFrame", Main)
        Page.Size = UDim2.new(1, -12, 1, -72)
        Page.Position = UDim2.new(0, 6, 0, 62)
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 2
        Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Page.Visible = idx == 1

        Instance.new("UIListLayout", Page).Padding = UDim.new(0, 6)

        Tabs[name] = Btn
        Pages[name] = Page

        Btn.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages) do p.Visible = false end
            for _, t in pairs(Tabs) do t.BackgroundColor3 = Color3.fromRGB(35, 35, 45) t.TextColor3 = Color3.fromRGB(180, 180, 180) end
            Page.Visible = true
            Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        return Page
    end

    local AimTab = NewTab("Aim", 1)
    local ESPTab = NewTab("ESP", 2)
    local MiscTab = NewTab("Misc", 3)
    local SetTab = NewTab("Extra", 4)

    Tabs["Aim"].BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    Tabs["Aim"].TextColor3 = Color3.fromRGB(255, 255, 255)

    -- UI Helpers
    local function Toggle(parent, text, default, flag, callback)
        local Btn = Instance.new("TextButton", parent)
        Btn.Size = UDim2.new(1, 0, 0, 30)
        Btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(45, 45, 55)
        Btn.Text = text .. ": " .. (default and "ON" or "OFF")
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.TextSize = 12
        Btn.Font = Enum.Font.Gotham
        Btn.AutoButtonColor = false
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

        local state = default
        Btn.MouseButton1Click:Connect(function()
            state = not state
            Btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(45, 45, 55)
            Btn.Text = text .. ": " .. (state and "ON" or "OFF")
            callback(state)
        end)
    end

    local function Slider(parent, text, min, max, default, suffix, callback)
        local Holder = Instance.new("Frame", parent)
        Holder.Size = UDim2.new(1, 0, 0, 44)
        Holder.BackgroundTransparency = 1

        local Label = Instance.new("TextLabel", Holder)
        Label.Size = UDim2.new(1, 0, 0, 16)
        Label.BackgroundTransparency = 1
        Label.Text = text .. ": " .. default .. suffix
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 12
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left

        local Track = Instance.new("Frame", Holder)
        Track.Size = UDim2.new(1, 0, 0, 6)
        Track.Position = UDim2.new(0, 0, 0, 22)
        Track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        Track.BorderSizePixel = 0
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame", Track)
        Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
        Fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        Fill.BorderSizePixel = 0
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function update(input)
            local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + pos * (max - min))
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            Label.Text = text .. ": " .. val .. suffix
            callback(val)
        end

        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                update(input)
            end
        end)
    end

    -- AIM TAB
    Toggle(AimTab, "Aimbot", false, "aim", function(v) Config.Aimbot.Enabled = v end)
    Toggle(AimTab, "Silent Aim", false, "silent", function(v) Config.SilentAim.Enabled = v if v then SetupSilentAim() end end)
    Toggle(AimTab, "Trigger Bot", false, "trigger", function(v) Config.TriggerBot.Enabled = v end)
    Toggle(AimTab, "Draw FOV", true, "fovvis", function(v) Config.Aimbot.DrawFOV = v end)
    Toggle(AimTab, "Team Check", true, "team", function(v) Config.Aimbot.TeamCheck = v end)
    Slider(AimTab, "FOV", 10, 400, 150, "px", function(v) Config.Aimbot.FOV = v end)
    Slider(AimTab, "Smooth", 1, 100, 12, "%", function(v) Config.Aimbot.Smoothness = v/100 end)
    Slider(AimTab, "Silent Hit", 1, 100, 100, "%", function(v) Config.SilentAim.HitChance = v end)

    -- ESP TAB
    Toggle(ESPTab, "ESP", false, "esp", function(v) Config.ESP.Enabled = v end)
    Toggle(ESPTab, "Boxes", true, "box", function(v) Config.ESP.Box = v end)
    Toggle(ESPTab, "Names", true, "name", function(v) Config.ESP.Name = v end)
    Toggle(ESPTab, "Health", true, "hp", function(v) Config.ESP.Health = v end)
    Toggle(ESPTab, "Tracers", true, "tracer", function(v) Config.ESP.Tracer = v end)
    Toggle(ESPTab, "Distance", false, "dist", function(v) Config.ESP.Distance = v end)
    Toggle(ESPTab, "Team Check", true, "espteam", function(v) Config.ESP.TeamCheck = v end)

    -- MISC TAB
    Toggle(MiscTab, "Wall Check", false, "wall", function(v) Config.Aimbot.WallCheck = v end)
    Slider(MiscTab, "Trigger Delay", 0, 200, 50, "ms", function(v) Config.TriggerBot.Delay = v/1000 end)

    local Unload = Instance.new("TextButton", MiscTab)
    Unload.Size = UDim2.new(1, 0, 0, 30)
    Unload.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    Unload.Text = "Unload Script"
    Unload.TextColor3 = Color3.fromRGB(255, 255, 255)
    Unload.TextSize = 12
    Unload.Font = Enum.Font.GothamBold
    Instance.new("UICorner", Unload).CornerRadius = UDim.new(0, 4)
    Unload.MouseButton1Click:Connect(function()
        pcall(function() SG:Destroy() end)
        for _, d in pairs(Drawings) do
            for _, obj in pairs(d) do pcall(function() obj:Remove() end) end
        end
        pcall(function() FOVcircle:Remove() end)
        pcall(function() RunService:UnbindFromRenderStep("RepoLoop") end)
    end)

    -- EXTRA / INFO
    local Info = Instance.new("TextLabel", SetTab)
    Info.Size = UDim2.new(1, 0, 0, 200)
    Info.BackgroundTransparency = 1
    Info.Text = "Keybinds:\nQ - Aimbot (Hold)\nRightCtrl - Toggle UI\n\nSilent Aim usa\nhook de metatable.\nTrigger atira\nauto no alvo."
    Info.TextColor3 = Color3.fromRGB(200, 200, 200)
    Info.TextSize = 13
    Info.Font = Enum.Font.Gotham
    Info.TextYAlignment = Enum.TextYAlignment.Top
    Info.TextXAlignment = Enum.TextXAlignment.Left

    -- Toggle UI
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
            Main.Visible = not Main.Visible
        end
    end)
end

CreateUI()

--// Main Loop (único, protegido)
RunService:BindToRenderStep("RepoLoop", 1, function()
    pcall(function()
        -- FOV Circle
        FOVcircle.Position = UserInputService:GetMouseLocation()
        FOVcircle.Radius = Config.Aimbot.FOV
        FOVcircle.Visible = Config.Aimbot.DrawFOV and (Config.Aimbot.Enabled or Config.SilentAim.Enabled)

        -- ESP
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local d = GetESP(plr)
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local head = char and char:FindFirstChild("Head")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if not Config.ESP.Enabled or not hum or not head or not hrp or hum.Health <= 0 or IsTeammate(plr, Config.ESP.TeamCheck) then
                d.Box.Visible = false
                d.BoxOutline.Visible = false
                d.Name.Visible = false
                d.Health.Visible = false
                d.Dist.Visible = false
                d.Tracer.Visible = false
                d.TracerOutline.Visible = false
                continue
            end

            local headPos, headVis = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local rootPos, rootVis = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            if not headVis and not rootVis then
                d.Box.Visible = false
                d.BoxOutline.Visible = false
                d.Name.Visible = false
                d.Health.Visible = false
                d.Dist.Visible = false
                d.Tracer.Visible = false
                d.TracerOutline.Visible = false
                continue
            end

            local h = math.abs(rootPos.Y - headPos.Y)
            local w = h * 0.55
            local pos = Vector2.new(headPos.X - w/2, headPos.Y)
            local color = Config.ESP.Color

            -- Box
            d.Box.Size = Vector2.new(w, h)
            d.Box.Position = pos
            d.Box.Color = color
            d.Box.Visible = Config.ESP.Box
            d.BoxOutline.Size = Vector2.new(w, h)
            d.BoxOutline.Position = pos
            d.BoxOutline.Visible = Config.ESP.Box

            -- Name
            d.Name.Text = plr.Name
            d.Name.Position = Vector2.new(headPos.X, headPos.Y - 18)
            d.Name.Visible = Config.ESP.Name

            -- Health
            d.Health.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
            d.Health.Position = Vector2.new(headPos.X, headPos.Y - 32)
            d.Health.Visible = Config.ESP.Health
            d.Health.Color = Color3.fromRGB(255 - (hum.Health/hum.MaxHealth)*255, (hum.Health/hum.MaxHealth)*255, 50)

            -- Distance
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                d.Dist.Text = dist .. "m"
                d.Dist.Position = Vector2.new(rootPos.X, rootPos.Y + 6)
                d.Dist.Visible = Config.ESP.Distance
            else
                d.Dist.Visible = false
            end

            -- Tracer
            local bottom = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            d.Tracer.From = bottom
            d.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
            d.Tracer.Color = color
            d.Tracer.Visible = Config.ESP.Tracer
            d.TracerOutline.From = bottom
            d.TracerOutline.To = Vector2.new(rootPos.X, rootPos.Y)
            d.TracerOutline.Visible = Config.ESP.Tracer
        end

        -- Aimbot
        if Config.Aimbot.Enabled then
            if UserInputService:IsKeyDown(Config.Aimbot.Key) then
                local target = GetClosestToMouse(Config.Aimbot.FOV, Config.Aimbot.TargetPart, Config.Aimbot.TeamCheck, Config.Aimbot.WallCheck)
                if target then
                    local part = GetPart(target, Config.Aimbot.TargetPart)
                    if part then
                        local targetCF = CFrame.new(Camera.CFrame.Position, part.Position)
                        Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(Config.Aimbot.Smoothness, 0.01, 0.99))
                    end
                end
            end
        end

        -- Trigger Bot
        RunTriggerBot()
    end)
end)
